{
  "name": "anora",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun run --hot apps/api/src/index.ts",
    "demo:api": "bun run --hot apps/api/src/demo.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run apps/api/src/index.ts",
    "typecheck": "tsc -p packages/core && tsc -p apps/api && tsc -p apps/web",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
